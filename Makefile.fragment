SHELL := /bin/bash
include .artifacts/bcf/local-cli.mk
BCF_PROJECT_PYTHON = $(BCF) ci project-python --repo-root .
BCF_EVIDENCE_DIR ?= .artifacts/bcf

.PHONY: governance-truthfulness release-check governance-exposure-scan governance-validate

governance-truthfulness:
	@python="$$($(BCF_PROJECT_PYTHON))" || exit $$?; "$$python" scripts/governance_truth.py --repo-root . --evidence-dir $(BCF_EVIDENCE_DIR)

governance-exposure-scan:
	@python="$$($(BCF_PROJECT_PYTHON))" || exit $$?; cd . && "$$python" scripts/check_governance_exposure.py --repo-root .

governance-validate:
	@python="$$($(BCF_PROJECT_PYTHON))" || exit $$?; cd . && "$$python" scripts/validate_governance_yaml.py --repo-root .

release-check:
	@python="$$($(BCF_PROJECT_PYTHON))" || exit $$?; \
	mkdir -p $(BCF_EVIDENCE_DIR); \
	for gate in governance-exposure-scan governance-validate; do \
		"$$python" scripts/governance_evidence.py --repo-root . run --gate $$gate --output $(BCF_EVIDENCE_DIR)/$$gate --python "$$python" || exit $$?; \
	done; \
	"$$python" scripts/governance_truth.py --repo-root . --evidence-dir $(BCF_EVIDENCE_DIR)

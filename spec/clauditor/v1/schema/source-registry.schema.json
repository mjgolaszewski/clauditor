{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clauditor.invalid/spec/v1/source-registry.schema.json",
  "type": "object",
  "required": [
    "document",
    "sources",
    "independent_required_source_edges",
    "independent_required_safety_edges",
    "independent_transition_population",
    "scope_reconstruction_rule"
  ],
  "properties": {
    "document": {
      "type": "object",
      "minProperties": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "independent_required_source_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "producer",
          "consumer",
          "source_ref",
          "signals"
        ],
        "properties": {
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "independent_required_safety_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "producer",
          "consumer",
          "source_ref"
        ],
        "properties": {
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "consumer": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "independent_transition_population": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "machine",
          "required_transition_ids"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "minLength": 1
          },
          "required_transition_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "scope_reconstruction_rule": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
